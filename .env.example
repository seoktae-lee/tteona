# tteona API 서버 환경변수
# 실제 값은 서버의 .env 또는 systemd 환경에 설정하고, 절대 git에 커밋하지 말 것.
# ⚠️ 기존에 소스코드에 하드코딩돼 있던 값들(PG 비밀번호, ODsay/Kakao/TourAPI 키,
#    관리자 비밀번호/토큰)은 git 이력에 남아 있으므로 반드시 "새 값으로 로테이션"해서 설정할 것.

# ─── 필수 (미설정 시 서버 기동 실패) ───────────────────────────
PG_PASSWORD=
ADMIN_PASSWORD=
ADMIN_TOKEN=

# ─── PostgreSQL (기본값 있음) ─────────────────────────────────
# PG_HOST=10.30.10.170
# PG_USER=tteona
# PG_DB=tteona_db

# ─── 외부 API 키 (미설정 시 해당 기능은 추정치/404 폴백) ─────────
ODSAY_KEY=
KAKAO_REST_KEY=
TOUR_API_KEY=

# Google Cloud Translation v2 — UGC(코스 제목) 번역용.
# 미설정 시 /api/translate가 원문을 그대로 반환하고 앱도 원문을 표시한다(기능만 꺼짐).
GOOGLE_TRANSLATE_KEY=

# ─── APNs (기본값: 기존 서버 경로/키) ─────────────────────────
# APNS_KEY_PATH=/home/ubuntu/tteona-api/keys/AuthKey_XXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=

# ─── 인증 강제 ────────────────────────────────────────────────
# 기본 true. 인증 헤더 없는 요청은 401.
# 구버전 앱(토큰 미전송)이 남아 있는 전환 기간에만 false로 완화 운영.
# AUTH_ENFORCE=true
