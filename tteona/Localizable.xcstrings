    "tutorial.bgm.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last step! 'Auto pick' chooses music that fits\nyour trip's mood. Let's make it!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後です！「自動おすすめ」が旅の雰囲気に合う\n音楽を選んでくれます。さっそく作りましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막이에요! '자동 추천'이 여행 분위기에 맞는\n음악을 골라줘요. 바로 만들어봐요!"
          }
        }
      }
    },
    "tutorial.capture.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the shutter to capture this moment!\nFree accounts can record up to 30 seconds a day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッターを押してこの瞬間を残しましょう！\n無料でも1日30秒まで撮れます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셔터를 눌러 이 순간을 짧은 영상으로 남겨봐요!\n무료로도 하루 30초까지 담을 수 있어요"
          }
        }
      }
    },
    "tutorial.done.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかりました！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요, 알겠어요!"
          }
        }
      }
    },
    "tutorial.done.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You captured one place this time. Free accounts get 30 seconds a day — pick 2, 3, or 5 seconds and capture more places!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回は1か所でしたが、無料でも1日30秒まで撮れます。2・3・5秒から選んでもっと多くの場所を残してみましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번엔 한 곳만 담았지만, 무료로도 하루 30초까지 담을 수 있어요. 2·3·5초 중에 골라 여러 곳을 담아보세요!"
          }
        }
      }
    },
    "tutorial.done.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First vlog complete!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めてのVlog完成！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 브이로그 완성!"
          }
        }
      }
    },
    "tutorial.endToday.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first place is captured!\nTap ✓ at the top right to turn it into a vlog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の場所が入りました！\n右上の✓を押してブイログにしましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 장소가 담겼어요!\n오른쪽 위 ✓를 눌러 브이로그로 만들어봐요"
          }
        }
      }
    },
    "tutorial.format.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We pre-picked the format that matches how you filmed.\nShall we go with it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影の向きに合ったフォーマットを選んでおきました。\nこのまま作ってみましょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 방향에 딱 맞는 포맷을 미리 골라놨어요.\n이대로 만들어볼까요?"
          }
        }
      }
    },
    "tutorial.myToday.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's make your first vlog together!\nJust tap the shutter on the Capture tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅のハイライト、ブイログを一緒に作りましょう！\n撮影タブでシャッターを押すだけです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행의 하이라이트, 브이로그를 같이 만들어봐요!\n촬영 탭에서 셔터만 누르면 시작이에요"
          }
        }
      }
    },
    "tutorial.pickPlace.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick where you are from the list!\nNot there? Tap \"Enter manually\" to type it in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今いる場所をここから選んでください！\nなければ「直接入力」で書けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 찍은 곳을 여기서 골라봐요!\n목록에 없으면 '직접 입력하기'로 적을 수 있어요"
          }
        }
      }
    },
