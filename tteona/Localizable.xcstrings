    "session.farCapture.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ to go until %1$@.\nIf GPS is off or you're indoors, it's fine to film now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@まで残り%2$@。\nGPSが不正確または屋内なら、今撮影しても大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 %@ 남았어요.\nGPS가 부정확하거나 실내라면 지금 촬영해도 괜찮아요."
          }
        }
      }
    },
    "session.farCapture.noLocation": {
      "extractionState": "manual",
