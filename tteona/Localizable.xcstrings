    "placedetail.blockDone.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The author has been blocked. Their reviews were removed from the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成者をブロックしました。リストからレビューが削除されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성자가 차단되었습니다. 목록에서 후기가 삭제되었습니다."
          }
        }
      }
    },
    "placedetail.blockReviewer.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block this reviewer? All of their courses and reviews will be hidden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレビュー作成者をブロックしますか？ブロックすると、この作成者のすべてのコースとレビューが非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리뷰 작성자를 차단하시겠어요? 차단하시면 이 작성자가 등록한 모든 코스와 후기가 숨겨집니다."
          }
        }
      }
