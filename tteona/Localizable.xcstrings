{
  "sourceLanguage": "ko",
  "strings": {
    "": {},
    "%@ %@": {
      "comment": "A flag icon followed by the name of the current app language.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ · %@": {
      "comment": "A tag emoji, followed by the tag name, followed by a separator, followed by the region.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ · %3$@"
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "A row that shows travel time and distance for a transportation option.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A circle with a number and a label. The number is the order of a place in the current session, and the label is the name of the place.",
      "isCommentAutoGenerated": true
    },
    "%lld%%": {
      "comment": "A label showing the progress of vlog generation. The argument is the percentage of completion.",
      "isCommentAutoGenerated": true
    },
    "%lld. %@": {
      "comment": "A title that shows the name of a place. The argument is the name of the place.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld. %2$@"
          }
        }
      }
    },
    "%lld/%lld": {
      "comment": "A label displaying the number of visited and ordered places. The first argument is the count of visited places. The second argument is the count of ordered places.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld/10": {
      "comment": "A label showing the number of characters in the user's nickname. The argument is the current nickname.",
      "isCommentAutoGenerated": true
    },
    "%lld° %@": {
      "comment": "The temperature and weather description.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld° %2$@"
          }
        }
      }
    },
    "-": {},
    "16:9": {
      "comment": "A label that shows the aspect ratio of the video.",
      "isCommentAutoGenerated": true
    },
    "9:16": {
      "comment": "A label that shows the aspect ratio of the video.",
      "isCommentAutoGenerated": true
    },
    "NEW": {
      "comment": "A label that indicates a new feed.",
      "isCommentAutoGenerated": true
    },
    "PRO": {
      "comment": "A badge that indicates a product is only available for PRO users.",
      "isCommentAutoGenerated": true
    },
    "TRAVEL": {
      "comment": "A heading displayed in the middle of the screen.",
      "isCommentAutoGenerated": true
    },
    "auth.alreadyHaveAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already have an account?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにアカウントをお持ちですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 계정이 있으신가요?"
          }
        }
      }
    },
    "auth.checkEmail.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a verification link to your email.\nClick the link, then tap the button below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録したメールアドレスに認証リンクを送信しました。\nリンクをクリックした後、下のボタンを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입하신 이메일로 인증 링크를 보냈어요.\n링크를 클릭한 후 아래 버튼을 눌러주세요."
          }
        }
      }
    },
    "auth.checkEmail.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Your Email"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールをご確認ください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일을 확인해주세요"
          }
        }
      }
    },
    "auth.checkSpam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't see the email, check your spam folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールが見つからない場合は、迷惑メールフォルダもご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일이 보이지 않으면 스팸함도 확인해주세요."
          }
        }
      }
    },
    "auth.confirmPassword": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호 확인"
          }
        }
      }
    },
    "auth.email": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일"
          }
        }
      }
    },
    "auth.emailAddress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소"
          }
        }
      }
    },
    "auth.emailSent.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A password reset link has been sent to your email. Please check your inbox."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力されたメールアドレスにパスワード再設定リンクを送信しました。受信トレイをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하신 이메일로 비밀번호 재설정 링크를 전송했어요. 메일함을 확인해주세요."
          }
        }
      }
    },
    "auth.emailSent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email Sent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールを送信しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일을 보냈어요"
          }
        }
      }
    },
    "auth.error.appleFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Sign-In failed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleログインに失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 로그인에 실패했습니다."
          }
        }
      }
    },
    "auth.error.emailInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This email is already registered. Please sign in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに登録されているメールアドレスです。ログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 가입된 이메일입니다. 로그인해주세요."
          }
        }
      }
    },
    "auth.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An error occurred. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーが発生しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류가 발생했습니다. 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.googleConfig": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Sign-In configuration error."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleログインの設定エラーです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 로그인 설정 오류입니다."
          }
        }
      }
    },
    "auth.error.googleFailedAndroid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Sign-In failed. (%@)\nPlease try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleログインに失敗しました。（%@）\nしばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 로그인에 실패했습니다. (%@)\n잠시 후 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.googleNoAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Google account is signed in on this device.\nAdd a Google account in Settings > Accounts and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にログイン済みのGoogleアカウントがありません。\n設定 > アカウントでGoogleアカウントを追加してから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 로그인된 Google 계정이 없어요.\n설정 > 계정에서 Google 계정을 추가한 뒤 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.googleToken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get the Google authentication token."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google認証トークンを取得できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 인증 토큰을 가져올 수 없습니다."
          }
        }
      }
    },
    "auth.error.initFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App initialization failed. Check your network and restart the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの初期化に失敗しました。ネットワークを確認して再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 초기화에 실패했어요. 네트워크 확인 후 다시 실행해주세요."
          }
        }
      }
    },
    "auth.error.invalidEmail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid email format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しいメールアドレス形式ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 이메일 형식이 아닙니다."
          }
        }
      }
    },
    "auth.error.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server response was invalid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの応答が正しくありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 응답이 올바르지 않아요."
          }
        }
      }
    },
    "auth.error.kakaoEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Kakao login response was empty. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カカオログインの応答が空です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카카오 로그인 응답이 비어 있어요. 잠시 후 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.kakaoFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakao Sign-In failed.\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カカオログインに失敗しました。\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카카오 로그인에 실패했습니다.\n%@"
          }
        }
      }
    },
    "auth.error.kakaoFailedSimple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakao Sign-In failed. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カカオログインに失敗しました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카카오 로그인에 실패했어요. 잠시 후 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.kakaoFirebase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakao sign-in worked, but we couldn't connect to the server.\nCheck your Wi-Fi/cellular connection, turn off any VPN or iCloud Private Relay, and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カカオログインはできましたが、サーバー（Firebase）に接続できませんでした。\nWi-Fi・モバイル接続を確認し、VPN・iCloudプライベートリレーを一時的にオフにしてから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카카오 로그인은 되었지만, 서버(Firebase)와 연결되지 않았어요.\nWi‑Fi·셀룰러 연결을 확인하고, VPN·iCloud 프라이베이트 릴레이를 잠시 끈 뒤 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.kakaoNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A network problem prevented Kakao sign-in from completing.\nCheck your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークの問題でカカオログインを完了できませんでした。\n接続状態を確認してから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 문제로 카카오 로그인을 마무리하지 못했어요.\n연결 상태를 확인한 뒤 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.kakaoNoRoute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakao sign-in worked, but no network route was found.\nCheck your internet connection, VPN, and firewall, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カカオログインはできましたが、ネットワーク経路が見つかりませんでした。\nインターネット接続・VPN・ファイアウォールを確認してから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카카오 로그인은 되었지만, 네트워크 경로를 찾을 수 없어요.\n인터넷 연결·VPN·방화벽을 확인한 뒤 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.kakaoOverlap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your login requests overlapped and couldn't be processed.\nPlease wait a moment and tap the Kakao button just once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインリクエストが重複して処理できませんでした。\nしばらくしてからカカオボタンを一度だけ押して再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 요청이 겹쳐 처리되지 못했어요.\n잠시 후 카카오 버튼을 한 번만 눌러 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A network error occurred."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークエラーが発生しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 오류가 발생했습니다."
          }
        }
      }
    },
    "auth.error.profileSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to save your profile. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールの保存に失敗しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 저장에 실패했어요. 다시 시도해주세요."
          }
        }
      }
    },
    "auth.error.serverResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server error (%d)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー応答エラー（%d）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 응답 오류 (%d)"
          }
        }
      }
    },
    "auth.error.shortPassword": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password must be at least 6 characters."
          }
        },
        "ja": {
