    "onboarding.slide1.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is right there when you open the app.\nTap the shutter — it records and stops on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開けばすぐカメラ。\nシャッターを押すだけで自動で撮影・停止します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열면 바로 카메라예요.\n셔터만 누르면 알아서 찍히고 멈춰요"
          }
        }
      }
    },
    "onboarding.slide1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open and shoot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いてすぐ撮影"
          }
