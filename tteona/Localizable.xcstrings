    },
    "vlog.invite.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign up to keep making vlogs and watch the places you've been fill your footprint map."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録すると次のブイログも作り続けられ、\n訪れた場所が足あとマップに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원가입하면 다음 브이로그도 계속 만들 수 있고,\n다녀온 곳이 발자취 지도에 쌓여요."
          }
        }
      }
    },
