    "session.integrity.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some places' video files couldn't be found, so the capture list was cleaned up automatically. You can film those places again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の場所の動画ファイルが確認できなかったため、撮影リストが自動的に整理されました。該当の場所は再撮影できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 장소의 영상 파일이 확인되지 않아 촬영 리스트가 자동으로 정리되었습니다. 해당 장소는 다시 촬영하실 수 있습니다."
          }
        }
      }
    },
