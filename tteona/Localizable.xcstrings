    "navguide.step1.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want a 30-second tour of tteona?\nI'll show you around"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tteonaを30秒で見て回りましょうか？\n私がご案内します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠나를 30초만에 둘러볼까요?\n제가 안내해드릴게요"
          }
        }
      }
    },
    "navguide.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm Naru!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは、ナルです！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요, 나루예요!"
          }
        }
      }
    },
    "navguide.step2.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See nearby courses on the map,\nthen switch to Explore for popular ones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図で近くのコースを見て、\n「探索」に切り替えて人気コースもチェック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도에서 주변 코스를 보고\n탐색으로 바꿔 인기 코스도 둘러보세요"
          }
        }
      }
    },
    "navguide.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find courses"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コースを探す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코스 찾기"
          }
        }
      }
    },
    "navguide.step3.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the shutter — it records and stops on its own.\nYour vlog is made without any editing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッターを押すだけで自動で撮影・停止。\n編集なしでブイログができます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셔터만 누르면 알아서 찍히고 멈춰요\n편집 없이 브이로그가 만들어져요"
          }
        }
      }
    },
    "navguide.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日を残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘을 남기기"
          }
        }
      }
    },
    "navguide.step4.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a group to share courses\nand your day with friends and family"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを作って友達や家族と\nコースと「私の今日」をシェア"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 만들어 친구·가족과\n코스와 '나의 오늘'을 공유해요"
          }
        }
      }
    },
    "navguide.step4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に出かける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 떠나기"
          }
        }
      }
    },
    "navguide.step5.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go anywhere today and just tap the shutter.\nYour day becomes a vlog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はどこへでも、シャッターを押すだけ。\n一日がブイログとして残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 어디든 가서 셔터만 눌러보세요\n하루가 브이로그로 남아요"
          }
        }
      }
    },
    "navguide.step5.title": {
