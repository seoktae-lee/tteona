            "state": "translated",
            "value": "켜자마자 촬영"
          }
        }
      }
    },
    "onboarding.slide2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick 2, 3, or 5 seconds per place.\nA few seconds each is enough to keep the day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2・3・5秒から選んで撮影。\n数秒ずつでも一日が記録されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2·3·5초 중에 골라 담아요.\n몇 초씩만 모여도 하루가 기록돼요"
          }
        }
      }
    },
    "onboarding.slide2.title": {
      "extractionState": "manual",
