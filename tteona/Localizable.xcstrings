    "vlog.caption.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a place and leave a line about that moment.\nLeave it empty to show just the place and time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を選んで、その時のひとことを残しましょう。\n空欄なら場所と時刻だけ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 골라 그때의 한마디를 남겨보세요.\n비워두면 장소와 시각만 나와요."
          }
        }
      }
