          "stringUnit": {
            "state": "translated",
            "value": "Can't determine your current location. It's fine to film now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を確認できません。今撮影しても大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치를 확인할 수 없어요. 지금 촬영해도 괜찮아요."
          }
        }
      }
