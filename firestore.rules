rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인한 사용자만 접근 가능
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isRoomMember(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]);
    }

    // users 컬렉션
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // isVerified, creatorLabel은 Firebase 콘솔(관리자)만 수정 가능
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isVerified', 'creatorLabel']);

      // footprints 서브컬렉션 (발자취 여행 기록)
      // 읽기: 로그인 유저 누구나(타인 프로필의 발자취 지도·경로 표시용), 쓰기: 본인만
      match /footprints/{footprintId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isOwner(userId);
      }
    }

    // users 민감정보 (FCM 토큰 등)
    match /userPrivate/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // courses 컬렉션
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // 작성자: 모든 필드 수정 가능
      // 다른 유저: likeCount 필드만, 정확히 ±1 범위에서만 수정 가능 (좋아요/취소)
      //   → 임의 값(예: 9999999) 주입 차단. increment(±1)의 결과값이
      //     request.resource.data.likeCount에 반영되므로 규칙에서 검증 가능.
      //   ※ 동일 유저의 반복 증가(중복 좋아요)까지 완전 차단하려면 좋아요를
      //     서버 API/likes 서브컬렉션으로 이전해야 함(별도 과제).
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) &&
          request.resource.data.likeCount is int &&
          request.resource.data.likeCount >= 0 &&
          (
            request.resource.data.likeCount == resource.data.likeCount + 1 ||
            request.resource.data.likeCount == resource.data.likeCount - 1
          )
        )
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // rooms 컬렉션
    // ⚠️ 배포 시점 주의: 초대코드 참여가 서버 API(/api/rooms/join) 경유로 바뀐
    //    앱 버전이 충분히 배포된 뒤에 이 규칙을 배포할 것 — 구버전 앱은
    //    클라이언트에서 inviteCode 쿼리로 참여하므로 이 규칙에서 막힌다.
    match /rooms/{roomId} {
      // 방 조회: 멤버만 (초대코드·멤버 목록이 전체 유저에게 노출되던 문제 차단)
      allow read: if isSignedIn() && resource.data.memberIds.hasAny([request.auth.uid]);

      // 방 생성: 본인이 방장 + 본인이 멤버에 포함된 방만
      allow create: if isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.memberIds.hasAll([request.auth.uid]);

      // 방 수정: 방 멤버만 (초대 참여는 서버 Admin SDK가 처리)
      allow update: if isSignedIn() && resource.data.memberIds.hasAny([request.auth.uid]);

      // 방 삭제: creatorId 기준으로 방장만 허용 (마지막 멤버 정리는 서버가 처리)
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      // members 서브컬렉션
      match /members/{memberId} {
        allow read: if isSignedIn() && isRoomMember(roomId);
        // 본인 문서만 쓰기 가능 (lastReadAt, lastReadPerMember 포함)
        allow write: if isSignedIn() && memberId == request.auth.uid;
      }

      // locations 서브컬렉션
      match /locations/{userId} {
        allow read: if isSignedIn() && isRoomMember(roomId);
        allow write: if isSignedIn() && userId == request.auth.uid;
      }

      // feed 서브컬렉션
      match /feed/{feedId} {
        allow read: if isSignedIn() && isRoomMember(roomId);
        allow create: if isSignedIn() && isRoomMember(roomId) && request.resource.data.userId == request.auth.uid;
        // 작성자: 모든 필드 수정/삭제 가능
        // 방 멤버: commentCount 필드만 수정 가능 (댓글 작성 시)
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (isRoomMember(roomId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']))
        );
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

        // comments 서브컬렉션
        match /comments/{commentId} {
          allow read: if isSignedIn() && isRoomMember(roomId);
          allow create: if isSignedIn() && isRoomMember(roomId) && request.resource.data.userId == request.auth.uid;
          allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
        }
      }
    }

    // fcmRequests 컬렉션 (Cloud Function이 처리)
    match /fcmRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // placeCache 컬렉션 (Google Places API 데이터 캐시 — PostgreSQL로 이전됨)
    //   쓰기를 잠가 캐시 오염(임의 유저가 조작된 사진·리뷰를 전체 유저에게 서빙) 차단.
    //   앱의 saveToFirestore는 try? 라 실패해도 무해하며, 신규 캐시는 PG(WAS)로만 적재된다.
    //   기존 레거시 데이터 서빙을 위해 읽기는 유지(PG 미스 시 폴백).
    match /placeCache/{key} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // placeReviews 컬렉션 (방문 장소 리뷰 및 평점)
    match /placeReviews/{placeKey} {
      allow read: if isSignedIn();
      match /reviews/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    // reports 컬렉션 (콘텐츠 신고)
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

  }
}
