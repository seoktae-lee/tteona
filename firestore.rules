rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인한 사용자만 접근 가능
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isRoomMember(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]);
    }

    // users 컬렉션
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // users 민감정보 (FCM 토큰 등)
    match /userPrivate/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // courses 컬렉션
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // 작성자: 모든 필드 수정 가능
      // 다른 유저: likeCount 필드만 수정 가능 (좋아요)
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // rooms 컬렉션
    match /rooms/{roomId} {
      // 방 목록 조회: 로그인한 사용자
      allow read: if isSignedIn();

      // 방 생성: 로그인한 사용자
      allow create: if isSignedIn();

      // 방 수정: 방 멤버이거나 (초대코드로 참여 시 memberIds 업데이트)
      allow update: if isSignedIn() && (
        resource.data.memberIds.hasAny([request.auth.uid]) ||
        // 초대 참여: memberIds에 본인 추가만 허용
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
         request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
         request.resource.data.memberIds.hasAny([request.auth.uid]))
      );

      // 방 삭제: 방장(첫 번째 멤버)만
      allow delete: if isSignedIn() && resource.data.memberIds[0] == request.auth.uid;

      // members 서브컬렉션
      match /members/{memberId} {
        allow read: if isSignedIn() && isRoomMember(roomId);
        allow write: if isSignedIn() && (
          // 본인 정보 쓰기
          memberId == request.auth.uid ||
          // 방 멤버가 다른 멤버 정보 쓰기(관리 기능이 필요할 때만)
          isRoomMember(roomId)
        );
      }

      // locations 서브컬렉션
      match /locations/{userId} {
        allow read: if isSignedIn() && isRoomMember(roomId);
        allow write: if isSignedIn() && userId == request.auth.uid;
      }

      // feed 서브컬렉션
      match /feed/{feedId} {
        allow read: if isSignedIn() && isRoomMember(roomId);
        allow create: if isSignedIn() && isRoomMember(roomId) && request.resource.data.userId == request.auth.uid;
        // 작성자: 모든 필드 수정/삭제 가능
        // 방 멤버: commentCount 필드만 수정 가능 (댓글 작성 시)
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (isRoomMember(roomId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']))
        );
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

        // comments 서브컬렉션
        match /comments/{commentId} {
          allow read: if isSignedIn() && isRoomMember(roomId);
          allow create: if isSignedIn() && isRoomMember(roomId) && request.resource.data.userId == request.auth.uid;
          allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
        }
      }
    }

    // fcmRequests 컬렉션 (Cloud Function이 처리)
    match /fcmRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

  }
}
